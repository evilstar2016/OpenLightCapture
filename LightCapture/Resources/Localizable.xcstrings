          "stringUnit": {
            "state": "translated",
            "value": "If you enabled access in System Settings, restart OpenLightCapture to apply it. Restarting ends the current screenshot. Start a new screenshot after the app reopens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已在系统设置中开启权限，请重启 OpenLightCapture 使其生效。重启会结束当前截图；重启后请重新开始截图。"
