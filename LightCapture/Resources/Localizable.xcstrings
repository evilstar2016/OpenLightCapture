      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scrolling screenshots require “%1$@” permission.\nAfter allowing access, quit and reopen OpenLightCapture before starting another screenshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动长截图需要“%1$@”权限。\n授权后请退出并重新打开 OpenLightCapture，再开始截图。"
          }
        }
      }
    },
    "permission.controlLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control permission is not active or was revoked. Automatic scrolling is paused.\nAfter allowing access, end this screenshot, then quit and reopen OpenLightCapture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动滚动控制权限尚未生效或已被撤销，已暂停滚动。\n授权后请结束本次截图，退出并重新打开 OpenLightCapture。"
          }
