      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scrolling screenshots require “%1$@” permission.\nAfter allowing access, quit and reopen OpenLightCapture before starting another screenshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动长截图需要“%1$@”权限。\n授权后请退出并重新打开 OpenLightCapture，再开始截图。"
          }
