      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for regular, manual scrolling, and automatic scrolling screenshots to read the screen area you select."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通截图、手动长截图和自动长截图都需要，用于读取你选择的屏幕画面。"
          }
