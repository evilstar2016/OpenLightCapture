      }
    },
    "permission.controlLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control permission is not active or was revoked. Automatic scrolling is paused.\nAfter allowing access, end this screenshot, then quit and reopen OpenLightCapture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动滚动控制权限尚未生效或已被撤销，已暂停滚动。\n授权后请结束本次截图，退出并重新打开 OpenLightCapture。"
          }
