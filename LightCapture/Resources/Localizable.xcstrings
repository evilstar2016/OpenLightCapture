      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for screenshots, scrolling screenshots, GIF recording, and video recording to read the screen area you select."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通截图、长截图、GIF 与视频录制需要读取所选屏幕区域。"
