    "long.selectionHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual mode needs Screen Recording; automatic mode also needs control permission. Restart after allowing access. Exclude fixed headers, footers, and scrollbars."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动长截图只需录屏权限；自动另需控制权限，授权后请重启 OpenLightCapture。请排除固定标题、底栏和滚动条。"
          }
        }
      }
    },
    "long.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ scroll · Confirmed %2$lld px · %#@seconds@"
          },
          "substitutions": {
            "seconds": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld second"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld seconds"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@滚动 · 已确认 %2$lld px · %#@seconds@"
          },
          "substitutions": {
            "seconds": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 秒"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "long.automaticHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scrolling is locked to the target window. You can move the pointer freely, pause, or end and preview at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定目标窗口自动滚动；鼠标可自由移动，可随时暂停或结束并预览。"
          }
        }
      }
    },
    "long.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down in small steps. Brief changes wait for alignment. The image is only copied after you finish editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小幅向下滚动；短暂变化会自动等待对齐，只有“完成”才会复制图片。"
          }
        }
      }
    },
    "long.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the image to stabilize and align. Stop scrolling briefly; confirmed content is retained."
