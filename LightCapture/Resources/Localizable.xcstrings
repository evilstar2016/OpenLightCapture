      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual mode needs Screen Recording; automatic mode also needs control permission. Restart after allowing access. Exclude fixed headers, footers, and scrollbars."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动长截图只需录屏权限；自动另需控制权限，授权后请重启 OpenLightCapture。请排除固定标题、底栏和滚动条。"
          }
        }
      }
    },
    "long.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ scroll · Confirmed %2$lld px · %#@seconds@"
          },
          "substitutions": {
            "seconds": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld second"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld seconds"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@滚动 · 已确认 %2$lld px · %#@seconds@"
          },
          "substitutions": {
            "seconds": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 秒"
                    }
                  }
                }
              }
            }
          }
        }
      }
