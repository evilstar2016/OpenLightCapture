      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scrolling also needs control permission to scroll the page. Regular and manual scrolling screenshots only need Screen Recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动长截图额外需要，用于自动滚动页面。普通截图和手动长截图只需上面的录屏权限。"
