    "long.automaticHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic scrolling is locked to the target window. You can move the pointer freely, pause, or end and preview at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定目标窗口自动滚动；鼠标可自由移动，可随时暂停或结束并预览。"
          }
        }
      }
    },
    "long.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down in small steps. Brief changes wait for alignment. The image is only copied after you finish editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小幅向下滚动；短暂变化会自动等待对齐，只有“完成”才会复制图片。"
          }
        }
      }
    },
