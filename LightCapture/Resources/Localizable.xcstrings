          "stringUnit": {
            "state": "translated",
            "value": "After allowing access in System Settings, choose “Quit OpenLightCapture” from the menu bar, then reopen the app and start a new screenshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置允许后，请从菜单栏选择“退出 OpenLightCapture”，再重新打开应用，重新开始截图。"
          }
